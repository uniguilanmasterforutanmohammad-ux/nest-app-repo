datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String         @id @default(uuid())
  phone         String         @unique
  phoneVerified Boolean        @default(false)
  email         String?        @unique
  googleId      String?        @unique
  fullName      String?
  avatarUrl     String?
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  businesses    Business[]
  subscriptions Subscription[]

  @@map("users")
}

model Otp {
  id        String   @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, code])
  @@map("otps")
}

model Plan {
  id              String         @id @default(uuid())
  name            String
  slug            String         @unique
  price           Int            @default(0)
  maxBusinesses   Int            @default(1)
  maxLinksPerPage Int            @default(10)
  hasCustomDomain Boolean        @default(false)
  hasAnalytics    Boolean        @default(false)
  createdAt       DateTime       @default(now())

  subscriptions   Subscription[]

  @@map("plans")
}

enum SubStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model Subscription {
  id        String    @id @default(uuid())
  userId    String
  planId    String
  status    SubStatus @default(ACTIVE)
  startDate DateTime  @default(now())
  endDate   DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      Plan      @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model Business {
  id        String    @id @default(uuid())
  userId    String
  name      String
  category  String?
  logoUrl   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bioPages  BioPage[]

  @@map("businesses")
}

model BioPage {
  id             String     @id @default(uuid())
  businessId     String
  slug           String     @unique
  title          String
  bio            String?    @db.Text
  avatarUrl      String?
  themeConfig    Json?
  customDomain   String?    @unique
  seoTitle       String?
  seoDescription String?
  isActive       Boolean    @default(true)
  viewCount      Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  business       Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  blocks         Block[]
  pageViews      PageView[]

  @@map("bio_pages")
}

enum BlockType {
  LINK
  SOCIAL_ICONS
  HEADER_TEXT
  IMAGE_BANNER
  VIDEO_EMBED
  FAQ
}

model Block {
  id         String      @id @default(uuid())
  bioPageId  String
  type       BlockType   @default(LINK)
  title      String?
  url        String?     @db.Text
  icon       String?
  orderIndex Int         @default(0)
  isActive   Boolean     @default(true)
  clickCount Int         @default(0)
  config     Json?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  bioPage    BioPage     @relation(fields: [bioPageId], references: [id], onDelete: Cascade)
  clicks     LinkClick[]

  @@map("blocks")
}

model PageView {
  id        String   @id @default(uuid())
  bioPageId String
  ipAddress String?
  userAgent String?  @db.Text
  device    String?
  referrer  String?
  createdAt DateTime @default(now())

  bioPage   BioPage  @relation(fields: [bioPageId], references: [id], onDelete: Cascade)

  @@index([bioPageId, createdAt])
  @@map("page_views")
}

model LinkClick {
  id        String   @id @default(uuid())
  blockId   String
  ipAddress String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  block     Block    @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@index([blockId, createdAt])
  @@map("link_clicks")
}
